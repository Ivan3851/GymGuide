# Copy to C:\ProgramData\GymGuide\config\gymguide.env and set a unique secret.
NODE_ENV=production
HOST=127.0.0.1
PORT=1337
MONGODB_URI=mongodb://127.0.0.1:27017/gymguide
GYMGUIDE_GYM_ID=demo-gym
SESSION_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES
# This kiosk serves loopback HTTP. Set true only if HTTPS is configured.
SESSION_COOKIE_SECURE=false
ADMIN_SESSION_MAX_AGE_MS=28800000
GYMGUIDE_MEDIA_DIR=C:\ProgramData\GymGuide\media
MEDIA_MAX_VIDEO_BYTES=536870912
MEDIA_MAX_IMAGE_BYTES=15728640
MONGODB_READINESS_RETRY_MS=2000
